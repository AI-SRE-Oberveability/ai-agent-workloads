{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "enabled",
    "profile",
    "image",
    "sourceRevision",
    "existingSecretName"
  ],
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "profile": {
      "enum": [
        "dev",
        "qa"
      ]
    },
    "image": {
      "type": "string",
      "pattern": "^$|^[a-z0-9./:_-]+@sha256:[0-9a-f]{64}$"
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^$|^[0-9a-f]{40}$"
    },
    "existingSecretName": {
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
    }
  },
  "if": {
    "properties": {
      "enabled": {
        "const": true
      }
    }
  },
  "then": {
    "properties": {
      "image": {
        "minLength": 1
      },
      "sourceRevision": {
        "minLength": 1
      },
      "existingSecretName": {
        "minLength": 1
      }
    }
  }
}
